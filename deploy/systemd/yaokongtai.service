[Unit]
Description=Yaokongtai secure Mac control relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=leo
Group=leo
WorkingDirectory=/opt/apps/yaokongtai/current
EnvironmentFile=/opt/apps/yaokongtai/shared/runtime.env
ExecStart=/usr/bin/node apps/relay/dist/main.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/apps/yaokongtai/shared/data

[Install]
WantedBy=multi-user.target
